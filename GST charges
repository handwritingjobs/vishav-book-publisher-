<script>

function customerLogin() {

    const mobile =
        document.getElementById("mobile").value.trim();

    if (
        mobile.length !== 10 ||
        !/^[0-9]+$/.test(mobile)
    ) {

        alert(
            "Please enter a valid 10-digit mobile number."
        );

        return;
    }

    document.getElementById("customerMobile")
        .textContent = mobile;

    document.getElementById("customerDashboard")
        .style.display = "block";

    document.getElementById("customerDashboard")
        .scrollIntoView({
            behavior: "smooth"
        });
}

</script>

